{
    "_comment": "Default 2D Poisson configuration",
    "problem": {"kind": "poisson", "case": "two_blob"},
    "grid": {
        "Nx": 64,
        "Ny": 64,
        "laplacian_stencil": "centered",
        "ghost_layers": null
    },
    "run": {
        "method": "h_unsplit",
        "cfl": 0.8,
        "omega": 1.30,
        "use_omega_opt": true,
        "iter_max": 2000,
        "norm": "fro",
        "dt_factor": 1.0,
        "multigrid": false,
        "stopping": {
            "tol_update": 1e-10,
            "tol_residual": 1e-5,
            "res_max": 1e8
        }
    },
    "methods": {
        "p_unsplit": {"gs_ordering": "lexicographic"},
        "h_unsplit": {
            "mode": "default",
            "theta": 0.785398163397,
            "normalize_direction": true,
            "direction_norm": 1.4142135623730951,
            "alpha": 0.8,
            "beta": 0.8,
            "eps_alpha": 0.05
        },
        "multigrid": {
            "solver": "fmg",
            "max_cycles": 200,
            "tol_update": 1e-5,
            "tol_residual": 1e-5,
            "res_max": 1e8,
            "nu1": 2,
            "nu2": 2,
            "min_coarse_n": 4,
            "coarse_max_sweeps": 100,
            "coarse_tol": 1e-6,
            "restriction": "full_weighting",
            "prolongation": "bilinear"
        }
    },
    "output": {"plot": false, "plot_exact": false}
}
